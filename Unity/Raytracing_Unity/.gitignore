# Unity generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Ss]tatistics/
/[Mm]igrations/

# Asset meta data must always be versioned next to its asset
!/[Aa]ssets/**/*.meta

# Autogenerated IDE solution and project files
/[Ee]xportedObj/
/.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.DotSettings.user
/.idea/
/.fleet/
/[Bb]uild[Bb]in[Bb]uilds/

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# The repository .gitignore excludes images and native binaries produced by the
# ray tracer. Assets shipped inside the project must still be versioned.
!/[Aa]ssets/**/*.png
!/[Aa]ssets/**/*.jpg
!/[Aa]ssets/**/*.jpeg
!/[Aa]ssets/**/*.gif
!/[Aa]ssets/**/*.tga
!/[Aa]ssets/**/*.psd
!/[Aa]ssets/**/*.exr
!/[Aa]ssets/**/*.hdr
!/[Aa]ssets/**/*.fbx
!/[Aa]ssets/**/*.wav
!/[Aa]ssets/**/*.mp3
!/[Aa]ssets/**/*.ogg
!/[Aa]ssets/**/*.mp4
!/[Aa]ssets/Plugins/**/*.dll
!/[Aa]ssets/Plugins/**/*.so
!/[Aa]ssets/Plugins/**/*.a
!/[Aa]ssets/Plugins/**/*.bundle
