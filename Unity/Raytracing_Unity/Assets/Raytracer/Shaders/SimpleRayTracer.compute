// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel CSMain

static const float c_rayPosNormalNudge = 0.01f;
static const float c_minimumRayHitTime = 0.01f;

static const float c_pi = 3.14159265359f;
static const float c_twopi = 2.0f * 3.14159265359f;

struct Material
{
    int matType;
    float3 albedo;

    float3 emissive;
    float emissiveStrength;
};

struct Triangle
{
    float3 v0;
    float3 v1;
    float3 v2;

    float3 n0;
    float3 n1;
    float3 n2;
};

struct MeshInfo
{
    uint triIndexStart;
    uint triCount;
    float3 boundMin;
    float3 boundMax;
    Material material;
};

struct Light
{
    float3 position;
    float radius;
    Material material;
};

struct Sphere
{
    float3 position;
    float radius;
    Material material;
};

struct Quad
{
    float4 center_sizeX;
    float4 normal_sizeY;
    float4 tangent;   // xyz : Right direction of the quad, w : pad
    float4 bitangent; // xyz : Up direction of the quad, w : pad
    Material material;
};

struct Ray
{
    float3 origin;
    float3 dir;
};

struct RayHitInfo
{
    bool didHit;
    float dist;
    float3 normal;
    Material material;
};

float3 ray_at(float t, in Ray ray)
{
    return ray.origin + t * ray.dir;
}

uint wang_hash(inout uint seed)
{
    seed = uint(seed ^ uint(61)) ^ uint(seed >> uint(16));
    seed *= uint(9);
    seed = seed ^ (seed >> 4);
    seed *= uint(0x27d4eb2d);
    seed = seed ^ (seed >> 15);
    return seed;
}

float RandomFloat01(inout uint state)
{
    return float(wang_hash(state)) / 4294967296.0;
}

float3 RandomUnitVector(inout uint state)
{
    float z = RandomFloat01(state) * 2.0f - 1.0f;
    float a = RandomFloat01(state) * c_twopi;
    float r = sqrt(1.0f - z * z);
    float x = r * cos(a);
    float y = r * sin(a);
    return float3(x, y, z);
}

float3 random_on_hemisphere(in float3 normal, inout uint state)
{
    float3 on_unit_sphere = RandomUnitVector(state);
    if (dot(on_unit_sphere, normal) > 0.0)
        return on_unit_sphere;
    else
        return -on_unit_sphere;
}

uint seed_from_position(float3 position)
{
    uint3 u = asuint(position);

    uint hash = u.x * 73856093u ^ u.y * 19349663u ^ u.z * 83492791u;

    hash = ((hash >> 16u) ^ hash) * 73244475u;
    hash = ((hash >> 16u) ^ hash) * 73244475u;
    hash = ((hash >> 16u) ^ hash);
    
    return hash;
}

// Create a RenderTexture with enableRandomWrite flag and set it
// with cs.SetTexture
RWTexture2D<float4> Result;

StructuredBuffer<Sphere> sphereMeshes;
int sphereMeshCount;

StructuredBuffer<Quad> quadMeshes;
int quadMeshCount;

StructuredBuffer<Light> sceneLights;
int totalSceneLightCount;

StructuredBuffer<Quad> sceneQuadLights;
int totalSceneQuadLightCount;

StructuredBuffer<Triangle> triangleList;
int totalTriangleCount;

StructuredBuffer<MeshInfo> meshList;
int totalMeshCount;

float4x4 _CameraToWorld;
float4x4 _CameraInverseProjection;
float3 cameraCenter;
float focalLength;

int rayBounceCount = 1;
int iFrame;

int perPixelSampleCount = 1;

uint ApplySkyBoxColor = 1;
float SkyColorApplyRatio = 1.0f;

float ScalarTriple(float3 u, float3 v, float3 w)
{
    return dot(cross(u, v), w);
}

bool IntersectTriangle(in Ray ray, in Triangle tri, in Material mat, inout RayHitInfo hitInfo)
{
    float t = 0;
    float u = 0;
    float v = 0;

    float3 edge1 = tri.v1 - tri.v0;
    float3 edge2 = tri.v2 - tri.v0;

    float3 pvec = cross(ray.dir, edge2);
    float det = dot(edge1, pvec);

    if (abs(det) < 1e-8)
        return false;

    float invDet = 1.0 / det;

    float3 tvec = ray.origin - tri.v0;
    u = dot(tvec, pvec) * invDet;
    if (u < 0.0 || u > 1.0)
        return false;

    float3 qvec = cross(tvec, edge1);
    v = dot(ray.dir, qvec) * invDet;
    if (v < 0.0 || u + v > 1.0)
        return false;

    float w = 1 - u - v;

    t = dot(edge2, qvec) * invDet;
    if (t > c_minimumRayHitTime && t < hitInfo.dist)
    {
        hitInfo.didHit = true;
        hitInfo.dist = t;
        hitInfo.normal = normalize(tri.n0 * w + tri.n1 * u + tri.n2 * v);
        hitInfo.material = mat;
        return true;
    }
    return false;
}

bool IntersectQuad(in Ray ray, in Quad quad, inout RayHitInfo hitInfo, inout uint rngState)
{
    float3 center = quad.center_sizeX.xyz;
    float3 normal = quad.normal_sizeY.xyz;
    float2 size = float2(quad.center_sizeX.w, quad.normal_sizeY.w);

    float denom = dot(ray.dir, normal);
    
    if (abs(denom) < 1e-6) return false;

    float t = dot(center - ray.origin, normal) / denom;

    if (t < 0.0f) return false;

    float3 pHit = ray.origin + ray.dir * t;
    float3 dirToHit = pHit - center;

    float localX = dot(dirToHit, quad.tangent.xyz);
    float localY = dot(dirToHit, quad.bitangent.xyz);

    float halfWidth = size.x * 0.5f;
    float halfHeight = size.y * 0.5f;

    if (abs(localX) <= halfWidth && abs(localY) <= halfHeight && t < hitInfo.dist)
    {
        hitInfo.didHit = true;
        hitInfo.dist = t;
        hitInfo.normal = random_on_hemisphere(quad.normal_sizeY.xyz, rngState);
        hitInfo.material = quad.material;
        return true; // Hit!
    }

    return false;
}

bool TestSphereTrace(in Ray ray, inout RayHitInfo info, in Sphere sphere, inout uint rngState)
{
	float3 m = ray.origin - sphere.position;
	float b = dot(m, ray.dir);
	float c = dot(m, m) - sphere.radius * sphere.radius;

	if(c > 0.0 && b > 0.0)
		return false;

	float discr = b * b - c;
	if(discr < 0.0)
		return false;

    bool fromInside = false;
	float dist = -b - sqrt(discr);
    if (dist < 0.0f)
    {
        fromInside = true;
        dist = -b + sqrt(discr);
    }
    
	if (dist > c_minimumRayHitTime && dist < info.dist)
    {
        info.didHit = true;
        info.dist = dist;
        float3 normal = normalize(ray_at(info.dist, ray) - sphere.position) * (fromInside ? -1.0f : 1.0f);
        info.normal = normal;
        info.material = sphere.material;
        return true;
    }

    return false;
}

// Slab test: returns true if the ray hits the AABB closer than maxDist
bool IntersectAABB(in Ray ray, in float3 boundMin, in float3 boundMax, in float maxDist)
{
    float3 invDir = 1.0f / ray.dir;
    float3 t0 = (boundMin - ray.origin) * invDir;
    float3 t1 = (boundMax - ray.origin) * invDir;

    float3 tSmall = min(t0, t1);
    float3 tBig = max(t0, t1);

    float tNear = max(max(tSmall.x, tSmall.y), tSmall.z);
    float tFar = min(min(tBig.x, tBig.y), tBig.z);

    return tNear <= tFar && tFar >= 0.0f && tNear < maxDist;
}

void TestIntersecrtionForMesh(in Ray ray, inout RayHitInfo hitInfo, in int triStart, in int triEnd, in Material mat)
{
    for(int i = triStart; i < triEnd; i++)
    {
        Triangle tri = triangleList[i];
        IntersectTriangle(ray, tri, mat, hitInfo);
    }
}

