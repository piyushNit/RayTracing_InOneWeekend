//========================== KERNALS ===================================
#pragma kernel CSMain

//========================== Constants ===================================

static const float c_rayPosNormalNudge = 0.01f;
static const float c_minimumRayHitTime = 0.01f;

static const float c_pi = 3.14159265359f;
static const float c_twopi = 2.0f * 3.14159265359f;

static const int    ITER_GEOMETRY = 3;
static const int    ITER_NORMAL   = 5;
static const float  OCEAN_FAR     = 2000.0;
static const float2x2 OCTAVE_M    = float2x2(1.6, 1.2, -1.2, 1.6);

//========================== Data types ===================================

struct Material
{
    int matType;
    float3 albedo;

    float3 emissive;
    float emissiveStrength;

    float reflectionFuzz;
    float refractionIndex;
    float2 pad0;
};

struct Triangle
{
    float3 v0;
    float3 v1;
    float3 v2;

    float3 n0;
    float3 n1;
    float3 n2;
};

struct MeshInfo
{
    uint triIndexStart;
    uint triCount;
    float3 boundMin;
    float3 boundMax;
    Material material;
};

struct Light
{
    float3 position;
    float radius;
    Material material;
};

struct Sphere
{
    float3 position;
    float radius;
    Material material;
};

struct Quad
{
    float4 center_sizeX;
    float4 normal_sizeY;
    float4 tangent;   // xyz : Right direction of the quad, w : pad
    float4 bitangent; // xyz : Up direction of the quad, w : pad
    Material material;
};

struct Ray
{
    float3 origin;
    float3 dir;
};

struct RayHitInfo
{
    uint hitFlag;
    bool isFrontFace;
    float dist;
    float3 normal;
    Material material;
};

//========================== Hit Flags ===================================
static const uint HIT_FLAG_TRUE         = 0x000001;
static const uint HIT_FLAG_WATER        = 0x000002;

