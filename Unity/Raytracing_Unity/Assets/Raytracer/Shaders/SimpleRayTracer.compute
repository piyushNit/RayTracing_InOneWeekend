//========================== Sea ======================================
float  seaHeight;
float  seaChoppy;
float  seaSpeed;
float  seaFreq;
float  seaSwellHeight;
float  seaReflectivity;      // scales Fresnel; 1 = physical
float3 seaBaseColor;         // deep water body colour
float3 seaWaterColor;        // sub-surface scatter colour (lit wave backs / crests)
float  seaFogDensity;

//========================== Random Number ===================================
uint wang_hash(inout uint seed)
{
    seed = uint(seed ^ uint(61)) ^ uint(seed >> uint(16));
    seed *= uint(9);
    seed = seed ^ (seed >> 4);
    seed *= uint(0x27d4eb2d);
    seed = seed ^ (seed >> 15);
    return seed;
}

float RandomFloat01(inout uint state)
{
    return float(wang_hash(state)) / 4294967296.0;
}

float3 RandomUnitVector(inout uint state)
{
    float z = RandomFloat01(state) * 2.0f - 1.0f;
    float a = RandomFloat01(state) * c_twopi;
    float r = sqrt(1.0f - z * z);
    float x = r * cos(a);
    float y = r * sin(a);
    return float3(x, y, z);
}

float3 random_on_hemisphere(in float3 normal, inout uint state)
{
    float3 on_unit_sphere = RandomUnitVector(state);
    if (dot(on_unit_sphere, normal) > 0.0)
        return on_unit_sphere;
    else
        return -on_unit_sphere;
}

uint seed_from_position(float3 position)
{
    uint3 u = asuint(position);

    uint hash = u.x * 73856093u ^ u.y * 19349663u ^ u.z * 83492791u;

    hash = ((hash >> 16u) ^ hash) * 73244475u;
    hash = ((hash >> 16u) ^ hash) * 73244475u;
    hash = ((hash >> 16u) ^ hash);
    
    return hash;
}

float hash12(float2 p)
{
    uint2 q = asuint(int2(p));
    uint h = (q.x * 1597334677u) ^ (q.y * 3812015801u);
    h = (h ^ (h >> 16)) * 0x27d4eb2du;
    h ^= h >> 15;
    return float(h) / 4294967296.0;
}

// Value noise in [-1, 1]
float noise2(float2 p)
{
    float2 i = floor(p);
    float2 f = frac(p);
    float2 u = f * f * (3.0 - 2.0 * f);
    return -1.0 + 2.0 * lerp(lerp(hash12(i), hash12(i + float2(1, 0)), u.x),
                             lerp(hash12(i + float2(0, 1)), hash12(i + float2(1, 1)), u.x), u.y);
}

float fbm2(float2 p)
{
    float v = 0.0;
    float a = 0.5;
    for (int i = 0; i < 5; i++)
    {
        v += a * noise2(p);
        p = mul(p, OCTAVE_M);
        a *= 0.5;
    }
    return v;
}


//========================== Ray & Lighting ===================================
float3 ray_at(float t, in Ray ray)
{
    return ray.origin + t * ray.dir;
}

float3 getHitPoint(in Ray ray, in RayHitInfo hitInfo)
{
    return ray_at(hitInfo.dist, ray) + hitInfo.normal * c_rayPosNormalNudge;
}

void applyColorOnly(in float3 color, inout float3 incomingLight, inout float3 rayColor)
{
    incomingLight += (float3)0 * rayColor;
    rayColor *= color;
}

void applyEnvironmentColor(in float3 color, inout float3 incomingLight, inout float3 rayColor)
{
    incomingLight += color * rayColor;
    rayColor *= (float3)1;
}

void applyColor(in Material mat, inout float3 incomingLight, inout float3 rayColor)
{
    float3 emittedLight = mat.emissive * mat.emissiveStrength;
    incomingLight += emittedLight * rayColor;
    rayColor *= mat.albedo;
}

static const float3 SEA_BASE           = float3(0.0,0.09,0.18) * 100;
static const float3 SEA_WATER_COLOR    = float3(0.8,0.9,0.6) * 100;
static const  float SEA_HEIGHT          = 0.6;

float3 getSkyColor(float3 e)
{
    e.y = max(e.y,0.0);
    float3 ret;
    ret.x = pow(1.0-e.y,2.0);
    ret.y = 1.0-e.y;
    ret.z = 0.6+(1.0-e.y)*0.4;
    return ret;
}

float diffuse(float3 n,float3 l,float p)
{
    return pow(dot(n,l) * 0.4 + 0.6,p);
}

float specular(float3 n,float3 l,float3 e,float s)
{    
    float nrm = (s + 8.0) / (3.1415 * 8.0);
    return pow(max(dot(reflect(e,n),l),0.0),s) * nrm;
}

float3 applyWaterColor(float3 p, float3 n, float3 l, float3 eye, float3 dist)
{
    float fresnel = 1.0 - max(dot(n,-eye),0.0);
    fresnel = pow(fresnel,3.0) * 0.65;
        
    // bteitler: Bounce eye ray off ocean towards sky, and get the color of the sky
    float3 reflected = getSkyColor(reflect(eye,n));    
    
    // bteitler: refraction effect based on angle between light surface normal
    float3 refracted = SEA_BASE + diffuse(n,l,80.0) * SEA_WATER_COLOR * 0.12; 
    
    // bteitler: blend the refracted color with the reflected color based on our fresnel term
    float3 color = lerp(refracted,reflected,fresnel);
    
    // bteitler: Apply a distance based attenuation factor which is stronger
    // at peaks
    float atten = max(1.0 - dot(dist,dist) * 0.001, 0.0);
    color += SEA_WATER_COLOR * (p.y - SEA_HEIGHT) * 0.18 * atten;
    
    // bteitler: Apply specular highlight
    color += (float3)specular(n,l,eye,60.0);
    
    return color;
}

void applyDiffuseMatRay(in RayHitInfo hitInfo, in Ray ray, inout float3 rayOrigin, inout float3 rayDir, inout uint rngState)
{
    rayOrigin = getHitPoint(ray, hitInfo);
    rayDir = random_on_hemisphere(hitInfo.normal, rngState);
}

void applyMetalMatRay(in RayHitInfo hitInfo, in Ray ray, inout float3 rayOrigin, inout float3 rayDir, inout uint rngState)
{
    rayOrigin = getHitPoint(ray, hitInfo);
    rayDir = normalize(reflect(ray.dir, hitInfo.normal)) + (hitInfo.material.reflectionFuzz * random_on_hemisphere(hitInfo.normal, rngState));
}

float reflectance(float cosine, float refraction_index)
{
    // Use Schlick's approximation for reflectance.
    float r0 = (1 - refraction_index) / (1 + refraction_index);
    r0 = r0 * r0;
    return r0 + (1 - r0) * pow((1 - cosine), 5);
}

void applyDielectricMatRay(in RayHitInfo hitInfo, in Ray ray, inout float3 rayOrigin, inout float3 rayDir, inout uint rngState)
{
    float ri = hitInfo.isFrontFace ? (1.0 / max(hitInfo.material.refractionIndex, 0.001)) : hitInfo.material.refractionIndex;

    float3 rayDirUnit = normalize(ray.dir);
    float cos_theta = min(dot(-rayDirUnit, hitInfo.normal), 1.0);
    float sin_theta = sqrt(1.0 - cos_theta * cos_theta);

    bool cannot_refract = ri * sin_theta > 1.0;
    bool reflected = cannot_refract || reflectance(cos_theta, ri) > RandomFloat01(rngState);
    float3 direction = (float3)0;

    if (reflected)
        direction = reflect(rayDirUnit, hitInfo.normal);
    else
        direction = refract(rayDirUnit, hitInfo.normal, ri);

    rayDir = direction;

    float nudgeSide = reflected ? 1.0f : -1.0f;
    rayOrigin = ray_at(hitInfo.dist, ray) + hitInfo.normal * (c_rayPosNormalNudge * nudgeSide);
}

float2 RandomInUnitDisk(inout uint state)
{
    float r = sqrt(RandomFloat01(state));
    float a = RandomFloat01(state) * c_twopi;
    return float2(r * cos(a), r * sin(a));
}

//========================== Ray cast & Intersections ===================================
float ScalarTriple(float3 u, float3 v, float3 w)
{
    return dot(cross(u, v), w);
}

bool IntersectTriangle(in Ray ray, in float3 v0, in float3 v1, in float3 v2, in float3 n0, in float3 n1, in float3 n2, in Material mat, in uint hitFlag, inout RayHitInfo hitInfo, inout uint rngState)
{
    float t = 0;
    float u = 0;
    float v = 0;

    float3 edge1 = v1 - v0;
    float3 edge2 = v2 - v0;

    float3 pvec = cross(ray.dir, edge2);
    float det = dot(edge1, pvec);

    if (abs(det) < 1e-8)
        return false;

    float invDet = 1.0 / det;

    float3 tvec = ray.origin - v0;
    u = dot(tvec, pvec) * invDet;
    if (u < 0.0 || u > 1.0)
        return false;

    float3 qvec = cross(tvec, edge1);
    v = dot(ray.dir, qvec) * invDet;
    if (v < 0.0 || u + v > 1.0)
        return false;

    float w = 1 - u - v;

    t = dot(edge2, qvec) * invDet;
    if (t > c_minimumRayHitTime && t < hitInfo.dist)
    {
        hitInfo.hitFlag = hitFlag;
        hitInfo.dist = t;
        //float3 normal = RandomUnitVector(rngState);//normalize(n0 * w + n1 * u + n2 * v);
        float3 normal = normalize(n0 * w + n1 * u + n2 * v);
        bool frontFace = dot(ray.dir, normal) < 0.0f;
        hitInfo.isFrontFace = frontFace;
        hitInfo.normal = frontFace ? normal : -normal;
        hitInfo.material = mat;
        return true;
    }
    return false;
}

bool IntersectQuad(in Ray ray, in Quad quad, inout RayHitInfo hitInfo, inout uint rngState)
{
    float3 center = quad.center_sizeX.xyz;
    float3 normal = quad.normal_sizeY.xyz;
    float2 size = float2(quad.center_sizeX.w, quad.normal_sizeY.w);

    float denom = dot(ray.dir, normal);
    
    if (abs(denom) < 1e-6) return false;

    float t = dot(center - ray.origin, normal) / denom;

    if (t < 0.0f) return false;

    float3 pHit = ray.origin + ray.dir * t;
    float3 dirToHit = pHit - center;

    float localX = dot(dirToHit, quad.tangent.xyz);
    float localY = dot(dirToHit, quad.bitangent.xyz);

    float halfWidth = size.x * 0.5f;
    float halfHeight = size.y * 0.5f;

    if (abs(localX) <= halfWidth && abs(localY) <= halfHeight && t < hitInfo.dist)
    {
        hitInfo.hitFlag = HIT_FLAG_TRUE;
        hitInfo.dist = t;
        bool frontFace = denom < 0.0f;
        hitInfo.isFrontFace = frontFace;
        hitInfo.normal = random_on_hemisphere(frontFace ? normal : -normal, rngState);
        hitInfo.material = quad.material;
        return true; // Hit!
    }

    return false;
}

bool TestSphereTrace(in Ray ray, inout RayHitInfo info, in Sphere sphere, inout uint rngState)
{
	float3 m = ray.origin - sphere.position;
	float b = dot(m, ray.dir);
	float c = dot(m, m) - sphere.radius * sphere.radius;

	if(c > 0.0 && b > 0.0)
		return false;

	float discr = b * b - c;
	if(discr < 0.0)
		return false;

    bool fromInside = false;
	float dist = -b - sqrt(discr);
    if (dist < 0.0f)
    {
        fromInside = true;
        dist = -b + sqrt(discr);
    }
    
	if (dist > c_minimumRayHitTime && dist < info.dist)
    {
        info.hitFlag = HIT_FLAG_TRUE;
        info.isFrontFace = !fromInside;
        info.dist = dist;
        float3 normal = normalize(ray_at(info.dist, ray) - sphere.position) * (fromInside ? -1.0f : 1.0f);
        info.normal = normal;
        info.material = sphere.material;
        return true;
    }

    return false;
}

// Slab test: returns true if the ray hits the AABB closer than maxDist
bool IntersectAABB(in Ray ray, in float3 boundMin, in float3 boundMax, in float maxDist)
{
    float3 invDir = 1.0f / ray.dir;
    float3 t0 = (boundMin - ray.origin) * invDir;
    float3 t1 = (boundMax - ray.origin) * invDir;

    float3 tSmall = min(t0, t1);
    float3 tBig = max(t0, t1);

    float tNear = max(max(tSmall.x, tSmall.y), tSmall.z);
    float tFar = min(min(tBig.x, tBig.y), tBig.z);

    return tNear <= tFar && tFar >= 0.0f && tNear < maxDist;
}

void TestIntersecrtionForMesh(in Ray ray, inout RayHitInfo hitInfo, in int triStart, in int triEnd, in Material mat, inout uint rngState)
{
    for(int i = triStart; i < triEnd; i++)
    {
        Triangle tri = triangleList[i];
        IntersectTriangle(ray, tri.v0, tri.v1, tri.v2, tri.n0, tri.n1, tri.n2, mat, HIT_FLAG_TRUE, hitInfo, rngState);
    }
}

void TestIntersectionForWaveMesh(in Ray ray, inout RayHitInfo hitInfo, in int triIndex, inout uint rngState)
{
    int index0 = waveIndexBuffer[triIndex + 0];
    int index1 = waveIndexBuffer[triIndex + 1];
    int index2 = waveIndexBuffer[triIndex + 2];

    float3 v0 = wavePositions[index0];
    float3 v1 = wavePositions[index1];
    float3 v2 = wavePositions[index2];

    float3 n0 = waveNormals[index0];
    float3 n1 = waveNormals[index1];
    float3 n2 = waveNormals[index2];

    IntersectTriangle(ray, v0, v1, v2, n0, n1, n2, waveMaterial[0], HIT_FLAG_WATER, hitInfo, rngState);
}

// One sharp-crested wave octave
float seaOctave(float2 uv, float choppy)
{
    uv += noise2(uv);
    float2 wv  = 1.0 - abs(sin(uv));
    float2 swv = abs(cos(uv));
    wv = lerp(wv, swv, wv);
    return pow(abs(1.0 - pow(abs(wv.x * wv.y), 0.65)), choppy);
}

float oceanMap(float3 p, int iterations)
{
    float freq   = seaFreq;
    float amp    = seaHeight;
    float choppy = seaChoppy;
    float2 uv = p.xz;
    uv.x *= 0.75;

    float t = 1.0 + oceanTime * seaSpeed;
    float h = 0.0;
    for (int i = 0; i < iterations; i++)
    {
        float d = seaOctave((uv + t) * freq, choppy) + seaOctave((uv - t) * freq, choppy);
        h += d * amp;
        uv = mul(uv, OCTAVE_M);
        freq *= 1.9;
        amp *= 0.22;
        choppy = lerp(choppy, 1.0, 0.2);
    }

    // Long directional swell (the big rolling wave in the foreground)
    h += seaSwellHeight * sin(dot(p.xz, float2(0.28, 0.96)) * 0.22 - oceanTime * 1.1);
    return p.y - h;
}

float3 oceanNormal(float3 p, float eps)
{
    float h = oceanMap(p, ITER_NORMAL);
    float3 n;
    n.x = oceanMap(float3(p.x + eps, p.y, p.z), ITER_NORMAL) - h;
    n.z = oceanMap(float3(p.x, p.y, p.z + eps), ITER_NORMAL) - h;
    n.y = eps;
    return normalize(n);
}

bool TraceOcean(in Ray ray, inout RayHitInfo hitInfo)
{
    float tm = 0.0;
    float tx = min(hitInfo.dist, OCEAN_FAR);

    float hx = oceanMap(ray_at(tx, ray), ITER_GEOMETRY);
    if (hx > 0.0)
        return false;   // the whole segment stays above the water

    float hm = oceanMap(ray_at(tm, ray), ITER_GEOMETRY);
    if (hm < 0.0)
        return false;   // ray starts below the surface (grazing reflection nudge)

    // Bisection / regular false towards the surface crossing
    float tmid = 0.0;
    for (int i = 0; i < 8; i++)
    {
        tmid = lerp(tm, tx, hm / (hm - hx));
        float hmid = oceanMap(ray_at(tmid, ray), ITER_GEOMETRY);
        if (hmid < 0.0) { tx = tmid; hx = hmid; }
        else            { tm = tmid; hm = hmid; }
    }

    if (tmid <= c_minimumRayHitTime || tmid >= hitInfo.dist)
        return false;

    hitInfo.hitFlag     = HIT_FLAG_WATER;
    hitInfo.dist        = tmid;
    hitInfo.isFrontFace = true;
    // Normal sampling footprint grows with distance to avoid far-field aliasing/moire
    hitInfo.normal      = oceanNormal(ray_at(tmid, ray), 0.001 + tmid * 0.002);
    hitInfo.material    = (Material)0;
    hitInfo.material.matType = 3;
    return true;
}

//========================== Loop Scene objects ===================================

void TestInTheScene(in Ray ray, inout RayHitInfo hitInfo, inout uint rngState)
{
    if(totalMeshCount > 0 && totalTriangleCount > 0)
    {
        for(int iMesh = 0; iMesh < totalMeshCount; iMesh++)
        {
            MeshInfo meshInfo = meshList[iMesh];
            if(!IntersectAABB(ray, meshInfo.boundMin, meshInfo.boundMax, hitInfo.dist))
                continue;

            int triangleStart = meshInfo.triIndexStart;
            int triangleEnd = triangleStart + meshInfo.triCount;
            TestIntersecrtionForMesh(ray, hitInfo, triangleStart, triangleEnd, meshInfo.material, rngState);
        }
    }

    /*if(waveIndexBufferCount >= 3)
    {
        for(int tri = 0; tri < waveIndexBufferCount; tri += 3)
        {
            TestIntersectionForWaveMesh(ray, hitInfo, tri, rngState);
        }
    }*/

    // Test with all the spheres
    for(int i = 0; i < sphereMeshCount; i++)
    {
        Sphere sph = sphereMeshes[i];
        if(TestSphereTrace(ray, hitInfo, sph, rngState))
        {
        }
    }

    TraceOcean(ray, hitInfo);
}

void applyOceanMaterial(in RayHitInfo hitInfo, in Ray ray, inout float3 rayOrigin, inout float3 rayDir, inout float3 incomingLight, inout float3 rayColor)
{
    float3 dir = normalize(ray.dir);
    float3 p = ray_at(hitInfo.dist, ray);
    float3 n = hitInfo.normal;

    // Schlick Fresnel for water (IOR 1.33 -> F0 ~ 0.02)
    float r0 = (1.0 - 1.33) / (1.0 + 1.33);
    r0 *= r0;
    float F = (r0 + (1.0 - r0) * pow(1.0 - saturate(dot(n, -dir)), 5.0)) * seaReflectivity;

    // Light that enters the water, scatters and comes back out (replaces tracing refraction)
    float sunLit = pow(saturate(dot(n, sunDirection)) * 0.4 + 0.6, 80.0);
    float3 body = seaBaseColor + seaWaterColor * 0.12 * sunLit;
    body += seaWaterColor * 0.10 * max(p.y - seaHeight * 0.5, 0.0);   // brighter crests

    // Aerial perspective toward the horizon
    float fog = 1.0 - exp(-hitInfo.dist * seaFogDensity);
    incomingLight += rayColor * fog * skyHorizonColor;
    rayColor *= (1.0 - fog);

    incomingLight += rayColor * (1.0 - F) * body;
    rayColor *= F;   // remaining energy follows the perfect mirror reflection (no noise)

    rayOrigin = p + n * c_rayPosNormalNudge;
    rayDir = reflect(dir, n);
}

void updateCurrState(in RayHitInfo hitInfo, in Ray ray, inout float3 rayOrigin, inout float3 rayDir, inout float3 incomingLight, inout float3 rayColor, inout uint rngState)
{
    switch(hitInfo.material.matType)
    {
        case 0://Diffuse
        {
            applyColor(hitInfo.material, incomingLight, rayColor);
            applyDiffuseMatRay(hitInfo, ray, rayOrigin, rayDir, rngState);
        }
            break;
        case 1://Metal
        {
            applyColor(hitInfo.material, incomingLight, rayColor);
            applyMetalMatRay(hitInfo, ray, rayOrigin, rayDir, rngState);
        }
            break;
        case 2://Dielectric
        {
            applyColor(hitInfo.material, incomingLight, rayColor);
            applyDielectricMatRay(hitInfo, ray, rayOrigin, rayDir, rngState);
        }
            break;
        case 3://Water
        {
            //applyColor(hitInfo.material, incomingLight, rayColor);
            //applyDielectricMatRay(hitInfo, ray, rayOrigin, rayDir, rngState);
            applyOceanMaterial(hitInfo, ray, rayOrigin, rayDir, incomingLight, rayColor);
        }
            break;
    }
}

float3 GetEnvironmentLight(in float3 rayDir)
{
    rayDir = normalize(rayDir);
    float3 col = lerp(skyHorizonColor, skyZenithColor, pow(max(rayDir.y, 0.0), 0.3));

    float sd = saturate(dot(rayDir, sunDirection));
    col += sunColor * (0.12 * pow(sd, 8.0) + 0.8 * pow(sd, 120) + 8.0 * pow(sd, 1500.0));

    // Clouds projected on a plane above the camera
    if(rayDir.y > 0.01)
    {
        float2 uv = rayDir.xz / rayDir.y;
        float dens = fbm2(uv * 0.35 + oceanTime * 0.01) * 0.5 + 0.5;
        float c = smoothstep(1.0 - cloudCoverage, 1.0 - cloudCoverage + 0.12, dens);
        c *= smoothstep(0.02, 0.2, rayDir.y);
        float shade = smoothstep(1.0 - cloudCoverage, 1.0 - cloudCoverage + 0.35, dens);
        float3 cloudCol = float3(0.95, 0.97, 1.0) - float3(0.40, 0.38, 0.32) * shade + float3(0.6, 0.6, 0.55) * pow(sd, 8.0);
        col = lerp(col, cloudCol, c);
    }

    float az = atan2(rayDir.x, rayDir.z);
    float sunAz = atan2(sunDirection.x, sunDirection.z);
    float rel = az - sunAz;
    rel = rel - c_twopi * floor((rel + c_pi) / c_twopi);
    float mask = smoothstep(-0.45, -0.25, rel) * (1.0 - smoothstep(1.4, 1.6, rel));
    float ridge = mountainHeight * (0.25 + 0.75 * smoothstep(-0.35, 0.9, rel)) * (0.55 + 0.45 * (fbm2(float2(rel * 5.0, 0.0)) * 0.5 + 0.5)) * mask;
    if(rayDir.y >= 0.0 && rayDir.y < ridge)
    {
        float haze = 0.12 + 0.45 * (1.0 * smoothstep(-0.3, 0.8, rel));
        col = lerp(float3(0.10, 0.17, 0.27), skyHorizonColor, haze);
    }

    return col;
}

float3 ray_color(in float3 initOrigin, in float3 initDir, inout uint rngState)
{
    float3 incomingLight = 0;
    float3 rayColor = 1;

    bool found = false;

    float3 rayOrigin = initOrigin;
    float3 rayDir = initDir;

    int totalFound = 1;

    for(int iBounce = 0; iBounce < rayBounceCount; iBounce++)
    {
        Ray newRay = (Ray)0;
        newRay.origin = rayOrigin;
        newRay.dir = rayDir;

        RayHitInfo hitInfo = (RayHitInfo)0;
        hitInfo.dist = 1.#INF;

        TestInTheScene(newRay, hitInfo, rngState);

        if(hitInfo.hitFlag != 0)
        {
            updateCurrState(hitInfo, newRay, rayOrigin, rayDir, incomingLight, rayColor, rngState);
            found = true;
            totalFound++;
        }else
        {
            //incomingLight += ApplySkyBoxColor ? GetEnvironmentLight(newRay.dir) * saturate(SkyColorApplyRatio) : (float3)0;
            if (ApplySkyBoxColor)
                applyEnvironmentColor(GetEnvironmentLight(newRay.dir), incomingLight, rayColor);
            break;
        }
    }

    #if 1 // draw sky
    //incomingLight /= (float)totalFound;
    if(found)
        return incomingLight;
    return GetEnvironmentLight(rayDir);
    #else
        return incomingLight;
    #endif
}

float3 defocusDiskSample(float3 center, float3 diskU, float3 diskV, inout uint rngState)
{
    float2 p = RandomInUnitDisk(rngState);
    return center + (p.x * diskU) + (p.y * diskV);
}

Ray CreateCameraRay(float2 uv, inout uint rngState)
{
    float2 xy = uv * 2.0f - 1.0f;
    float4 rayPos = mul(_CameraInverseProjection, float4(xy, 0.0f, 1.0f));
    float3 rayDir = mul(_CameraToWorld, float4(rayPos.xyz, 0.0f)).xyz;
    rayDir = normalize(rayDir);

    float3 rayOrigin = _CameraToWorld._m03_m13_m23;

    Ray camRay;
    camRay.origin = rayOrigin;
    camRay.dir = rayDir;

    if (defocusAngle <= 0 || defocusDist <= 0)
        return camRay;

    // Camera basis (Unity cameraToWorldMatrix: +X right, +Y up, -Z forward)
    float3 camRight   = normalize(mul((float3x3)_CameraToWorld, float3(1.0f, 0.0f, 0.0f)));
    float3 camUp      = normalize(mul((float3x3)_CameraToWorld, float3(0.0f, 1.0f, 0.0f)));
    float3 camForward = normalize(mul((float3x3) _CameraToWorld, float3(0.0f, 0.0f, -1.0f)));

    // Point where this pixel's pinhole ray crosses the (planar) focus plane
    float3 focusPoint = rayOrigin + rayDir * (defocusDist / dot(rayDir, camForward));

    // Lens disk radius from the aperture angle
    float defocusRadius = defocusDist * tan(radians(defocusAngle * 0.5f));
    float3 lensPoint = defocusDiskSample(rayOrigin, camRight * defocusRadius, camUp * defocusRadius, rngState);

    camRay.origin = lensPoint;
    camRay.dir = normalize(focusPoint - lensPoint);
    return camRay;
}

[numthreads(8, 8, 1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    uint width, height;
    Result.GetDimensions(width, height);
    if(id.x >= width || id.y >= height) return;

    uint rngState = uint(uint(id.x) * uint(1973) + uint(id.y) * uint(9277) + uint(iFrame) * uint(26699)) | uint(1);

    float2 uv = float2((float)id.x / (float)width, (float)id.y / (float)height);

    float3 accumulatedColor = float3(0, 0, 0);

    int sameplCount = max(perPixelSampleCount, 1);
    for(int i = 0; i < sameplCount; i++)
    {
        float jitterX = RandomFloat01(rngState);
        float jitterY = RandomFloat01(rngState);

        float2 uv = float2((float(id.x) + jitterX) / (float)width, (float(id.y) + jitterY) / (float)height);

        Ray ray = CreateCameraRay(uv, rngState);
        accumulatedColor += ray_color(ray.origin, ray.dir, rngState);
    }

    accumulatedColor /= (float)sameplCount;

    Result[id.xy] = float4(accumulatedColor, 1.0);
}
