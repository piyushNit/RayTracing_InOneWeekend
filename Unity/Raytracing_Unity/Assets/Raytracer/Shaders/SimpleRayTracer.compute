    if(totalMeshCount > 0 && totalTriangleCount > 0)
    {
        for(int iMesh = 0; iMesh < totalMeshCount; iMesh++)
        {
            MeshInfo meshInfo = meshList[iMesh];
            // Skip the mesh if the ray misses its bounds (or hits them behind the closest hit so far)
            if(!IntersectAABB(ray, meshInfo.boundMin, meshInfo.boundMax, hitInfo.dist))
                continue;

            int triangleStart = meshInfo.triIndexStart;
            int triangleEnd = triangleStart + meshInfo.triCount;
            TestIntersecrtionForMesh(ray, hitInfo, triangleStart, triangleEnd, meshInfo.material);
        }
    }

    // Test with all the spheres
    for(int i = 0; i < sphereMeshCount; i++)
    {
        Sphere sph = sphereMeshes[i];
        if(TestSphereTrace(ray, hitInfo, sph, rngState))
        {
        }
    }
}

void updateDiffuseMaterial(in Material mat, inout float3 incomingLight, inout float3 rayColor)
{
    float3 emittedLight = mat.emissive * mat.emissiveStrength;
    incomingLight += emittedLight * rayColor;
    rayColor *= mat.albedo;
}

void updateRay(in RayHitInfo hitInfo, in Ray ray, inout float3 rayOrigin, inout float3 rayDir, inout uint rngState)
{
    rayOrigin = ray_at(hitInfo.dist, ray) + hitInfo.normal * c_rayPosNormalNudge;
    rayDir = random_on_hemisphere(hitInfo.normal, rngState);
}

void updateCurrState(in RayHitInfo hitInfo, in Ray ray, inout float3 rayOrigin, inout float3 rayDir, inout float3 incomingLight, inout float3 rayColor, inout uint rngState)
{
    updateDiffuseMaterial(hitInfo.material, incomingLight, rayColor);
    updateRay(hitInfo, ray, rayOrigin, rayDir, rngState);
}

float3 GetEnvironmentLight(in float3 rayDir)
{
    float3 unit_direction = normalize(rayDir);
    float a = 0.5 * (unit_direction.y + 1.0f);
    return lerp(float3(1.0, 1.0, 1.0), float3(0.5, 0.7, 1.0), a);
}

float3 ray_color(in float3 initOrigin, in float3 initDir, inout uint rngState)
{
    float3 incomingLight = 0;
    float3 rayColor = 1;

    bool found = false;

    float3 rayOrigin = initOrigin;
    float3 rayDir = initDir;

    int totalFound = 1;

    for(int iBounce = 0; iBounce < rayBounceCount; iBounce++)
    {
        Ray newRay = (Ray)0;
        newRay.origin = rayOrigin;
        newRay.dir = rayDir;

        RayHitInfo hitInfo = (RayHitInfo)0;
        hitInfo.dist = 1.#INF;

        TestInTheScene(newRay, hitInfo, rngState);

        if(hitInfo.didHit)
        {
            updateCurrState(hitInfo, newRay, rayOrigin, rayDir, incomingLight, rayColor, rngState);
            found = true;
            totalFound++;
        }else
        {
            incomingLight += ApplySkyBoxColor ? GetEnvironmentLight(newRay.dir) * saturate(SkyColorApplyRatio) : (float3)0;
            break;
        }
    }

    #if 1 // draw sky
    //incomingLight /= (float)totalFound;
    if(found)
        return incomingLight;
    return GetEnvironmentLight(rayDir);
    #else
        return incomingLight;
    #endif
}

Ray CreateCameraRay(float2 uv)
{
    float2 xy = uv * 2.0f - 1.0f;
    float4 rayPos = mul(_CameraInverseProjection, float4(xy, 0.0f, 1.0f));
    float3 rayDir = mul(_CameraToWorld, float4(rayPos.xyz, 0.0f)).xyz;
    rayDir = normalize(rayDir);

    float3 rayOrigin = _CameraToWorld._m03_m13_m23;

    Ray camRay;
    camRay.origin = rayOrigin;
    camRay.dir = rayDir;
    return camRay;
}

[numthreads(8,8,1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    uint width, height;
    Result.GetDimensions(width, height);
    if(id.x >= width || id.y >= height) return;

    uint rngState = uint(uint(id.x) * uint(1973) + uint(id.y) * uint(9277) + uint(iFrame) * uint(26699)) | uint(1);

    float2 uv = float2((float)id.x / (float)width, (float)id.y / (float)height);

    float3 accumulatedColor = float3(0, 0, 0);

    int sameplCount = max(perPixelSampleCount, 1);
    for(int i = 0; i < sameplCount; i++)
    {
        float jitterX = RandomFloat01(rngState);
        float jitterY = RandomFloat01(rngState);

        float2 uv = float2((float(id.x) + jitterX) / (float)width, (float(id.y) + jitterY) / (float)height);

        Ray ray = CreateCameraRay(uv);
        accumulatedColor += ray_color(ray.origin, ray.dir, rngState);
    }

    accumulatedColor /= (float)sameplCount;

    Result[id.xy] = float4(accumulatedColor, 1.0);
}
