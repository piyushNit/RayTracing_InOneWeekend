    //         IntersectQuad(ray, quad, hitInfo, rngState);
    //     }
    // }

    // if(totalSceneLightCount > 0)
    // {
    //     for(int i = 0; i < totalSceneLightCount; i++)
    //     {
    //         // Test with lights
    //         Light sceneLight = sceneLights[i];
    //         Sphere lightSph;
