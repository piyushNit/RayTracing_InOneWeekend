int totalTriangleCount;

StructuredBuffer<MeshInfo> meshList;
int totalMeshCount;

StructuredBuffer<float3> wavePositions;
StructuredBuffer<float3> waveNormals;
StructuredBuffer<int> waveIndexBuffer;
StructuredBuffer<Material> waveMaterial;

int waveIndexBufferCount;

float4x4 _CameraToWorld;
float4x4 _CameraInverseProjection;
float3 cameraCenter;
float focalLength;

float3 sunPosition;

int rayBounceCount = 1;
int iFrame;

int perPixelSampleCount = 1;

uint ApplySkyBoxColor = 1;
float SkyColorApplyRatio = 1.0f;

float defocusAngle = 0;
float defocusDist = 0;

