# Rendered output - generated by running the ray tracer
*.png
*.jpg

# Unity
# The Unity project lives in Unity/Raytracing_Unity and carries its own
# .gitignore for editor generated data (Library, Temp, Logs, IDE projects).
# Unity assets are source files and must be versioned, so the image and
# binary rules above are re-included for any Assets folder in the repo.
!**/Assets/**/*.png
!**/Assets/**/*.jpg
!**/Assets/**/*.jpeg
!**/Assets/**/*.gif
!**/Assets/**/*.tga
!**/Assets/**/*.psd
!**/Assets/**/*.exr
!**/Assets/**/*.hdr
!**/Assets/**/*.fbx
!**/Assets/**/*.wav
!**/Assets/**/*.mp3
!**/Assets/**/*.ogg
!**/Assets/**/*.mp4
!**/Assets/Plugins/**/*.dll
!**/Assets/Plugins/**/*.so
!**/Assets/Plugins/**/*.a
!**/Assets/Plugins/**/*.bundle

# OS / editor clutter
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*~
.vscode/
.idea/
